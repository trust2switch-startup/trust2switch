// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  email       String   @unique
  password    String
  role        String   @default("admin") // "admin", "editor", "custom"
  permissions Json?    // Array of Permission objects
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}

model Course {
  id                    String   @id @default(uuid())
  slug                  String   @unique
  title                 String   @db.Text
  description           String   @db.Text
  longDescription       String   @db.LongText
  instructor            Json     // Instructor object
  image                 String
  category              String
  level                 String   // "Beginner", "Intermediate", "Advanced"
  duration              String
  price                 Float
  originalPrice         Float?
  rating                Float
  reviews               Int      @default(0)
  students              Int      @default(0)
  language              String
  features              Json     // String[]
  bulletPoints          Json     // String[]
  brochureDownloadLink  String?
  noCostEMIAmount       String?
  admissionDeadlineDate String?
  whoCanApply           Json     // String[]
  programHighlights     Json     // ProgramHighlight[]
  projects              Json     // Project[]
  skills                Json     // Skill[]
  comparisonData        Json     // ComparisonRow[]
  careerTransitions     Json     // CareerTransition[]
  faqs                  Json     // FAQ[]
  jobDescriptionsLink   String?
  certificate           Json?    // Certificate object
  curriculum            Json     // CurriculumModule[]
  tags                  Json     // String[]
  isPopular             Boolean  @default(false)
  isNew                 Boolean  @default(false)
  isVisible             Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([category])
  @@index([level])
  @@index([isPopular])
  @@index([rating])
  @@index([isNew])
  @@index([isVisible])
  @@fulltext([title, description]) 
}

model Product {
  id              String   @id @default(uuid())
  sku             String   @unique
  title           String   @db.Text
  description     String   @db.Text
  longDescription String?  @db.LongText
  image           String
  category        String
  price           Float
  originalPrice   Float?
  currency        String   @default("INR")
  inStock         Boolean  @default(true)
  stockQuantity   Int?
  rating          Float?
  reviews         Int?
  tags            Json?    // String[]
  features        Json?    // String[]
  fileFormat      String?
  fileSize        String?
  deliveryMethod  String?
  isPopular       Boolean?
  isNew           Boolean?
  isFeatured      Boolean?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([inStock])
  @@index([isPopular])
  @@index([isFeatured])
  @@index([isNew])
  @@fulltext([title, description])
}

model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String   @db.Text
  excerpt     String   @db.Text
  content     String   @db.LongText
  author      Json     // Author object
  image       String
  category    String
  tags        Json?    // String[]
  publishedAt String
  readTime    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@fulltext([title, excerpt, content])
}

model ProfessionalCourse {
  id          String   @id @default(uuid())
  title       String   @db.Text
  description String   @db.Text
  icon        String
  slug        String   @unique
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@fulltext([title, description])
}

model SchoolSubject {
  id          String   @id @default(uuid())
  title       String   @db.Text
  description String   @db.Text
  icon        String
  slug        String   @unique
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@fulltext([title, description])
}

model Content {
  id         String   @id @default(uuid())
  site       Json     // Site config
  navigation Json     // Navigation config
  home       Json     // Home page content
  courses    Json     // Courses page content
  about      Json     // About page content
  contact    Json     // Contact page content
  blog       Json     // Blog page content
  shop       Json     // Shop page content
  footer     Json     // Footer content
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CallbackRequest {
  id            String   @id @default(uuid())
  name          String
  phone         String
  preferredTime String
  message       String   @default("")
  status        String   @default("pending") // "pending", "contacted", "completed"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([preferredTime])
  @@fulltext([name, phone, message])
}
