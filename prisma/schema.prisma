generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model BlogPost {
  id          String   @id
  slug        String   @unique
  title       String   @db.Text
  excerpt     String   @db.Text
  content     String   @db.LongText
  author      Json
  image       String
  category    String
  tags        Json?
  publishedAt String
  readTime    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([category])
  @@fulltext([title, excerpt, content])
}

model CallbackRequest {
  id            String   @id @default(uuid())
  name          String
  phone         String
  preferredTime String
  message       String   @default("")
  status        String   @default("pending")
  courseName    String?
  intent        String   @default("callback")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([intent])
  @@index([preferredTime])
  @@index([status])
  @@fulltext([name, phone, message])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Content {
  id         String   @id
  site       Json
  navigation Json
  home       Json
  courses    Json
  about      Json
  contact    Json
  blog       Json
  shop       Json
  footer     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Course {
  id                    String   @id
  slug                  String   @unique
  title                 String   @db.Text
  description           String   @db.Text
  longDescription       String   @db.LongText
  instructor            Json
  image                 String
  category              String
  level                 String
  duration              String
  price                 Float
  originalPrice         Float?
  rating                Float
  reviews               Int      @default(0)
  students              Int      @default(0)
  language              String
  features              Json
  bulletPoints          Json
  brochureDownloadLink  String?
  noCostEMIAmount       String?
  admissionDeadlineDate String?
  whoCanApply           Json
  programHighlights     Json
  projects              Json
  skills                Json
  comparisonData        Json
  careerTransitions     Json
  faqs                  Json
  jobDescriptionsLink   String?
  certificate           Json?
  curriculum            Json
  tags                  Json
  isPopular             Boolean  @default(false)
  isNew                 Boolean  @default(false)
  isVisible             Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime

  @@index([category])
  @@index([isNew])
  @@index([isPopular])
  @@index([isVisible])
  @@index([level])
  @@index([rating])
  @@fulltext([title, description])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Product {
  id              String   @id
  sku             String   @unique
  title           String   @db.Text
  description     String   @db.Text
  longDescription String?  @db.LongText
  image           String
  category        String
  price           Float
  originalPrice   Float?
  currency        String   @default("INR")
  inStock         Boolean  @default(true)
  stockQuantity   Int?
  rating          Float?
  reviews         Int?
  tags            Json?
  features        Json?
  fileFormat      String?
  fileSize        String?
  deliveryMethod  String?
  isPopular       Boolean?
  isNew           Boolean?
  isFeatured      Boolean?
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([category])
  @@index([inStock])
  @@index([isFeatured])
  @@index([isNew])
  @@index([isPopular])
  @@fulltext([title, description])
}

model ProfessionalCourse {
  id          String   @id
  title       String   @db.Text
  description String   @db.Text
  icon        String
  slug        String   @unique
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@fulltext([title, description])
}

model SchoolSubject {
  id          String   @id
  title       String   @db.Text
  description String   @db.Text
  icon        String
  slug        String   @unique
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@fulltext([title, description])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model User {
  id          String   @id
  username    String   @unique
  email       String   @unique
  password    String
  role        String   @default("admin")
  permissions Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([isActive])
  @@index([role])
}

model ProjectRequest {
  id                 String   @id @default(uuid())
  name               String
  mobile             String
  email              String
  projectTechStack   String
  projectRequirement String?  @db.Text
  college            String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
